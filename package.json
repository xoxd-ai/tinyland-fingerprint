{
  "name": "@tummycrypt/tinyland-fingerprint",
  "version": "1.0.0",
  "private": true,
  "description": "Fingerprint intelligence services: enrichment, search, history, settings, validation, and caching",
  "type": "module",
  "license": "Zlib AND LicenseRef-Tinyland-Proprietary",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "import": "./dist/services/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:package": "publint"
  },
  "dependencies": {
    "ua-parser-js": "^2.0.10"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "publint": "^0.3.25",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xoxd-ai/tinyland-fingerprint.git"
  },
  "packageManager": "pnpm@10.13.1",
  "homepage": "https://github.com/xoxd-ai/tinyland-fingerprint",
  "bugs": {
    "url": "https://github.com/xoxd-ai/tinyland-fingerprint/issues"
  }
}
