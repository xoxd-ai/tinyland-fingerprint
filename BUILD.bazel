"""
BUILD.bazel for @tummycrypt/tinyland-fingerprint.

Dual-mode build: works with both pnpm (standalone) and Bazel (CI/production).
  Standalone: cd packages/tinyland-fingerprint && pnpm build
"""

load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@tummycrypt_tinyland_fingerprint_npm//:defs.bzl", "npm_link_all_packages")
load("@tummycrypt_tinyland_fingerprint_npm//:vitest/package_json.bzl", vitest_bin = "bin")

npm_link_all_packages(name = "node_modules")

# CARE ITEM (TIN-1744, 5/5): node_modules/@tummycrypt/tinyland-security link
# and its ts_project/vitest_test deps entries dropped here. See MODULE.bazel
# for the full rationale — the only import that needed this wiring is now
# inlined locally in FingerprintClientIdentityService.ts.

ts_project(
    name = "tinyland_fingerprint",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = [
            "src/**/*.test.ts",
            "src/**/*.spec.ts",
        ],
    ) + ["package.json"],
    declaration = True,
    declaration_map = True,
    source_map = False,
    tsconfig = ":tsconfig.json",
    transpiler = "tsc",
    out_dir = "dist",
    root_dir = "src",
    validate = False,
    deps = [
        ":node_modules",
        ":node_modules/ua-parser-js",
        ":node_modules/@types/node",
        ":node_modules/@types/ua-parser-js",
    ],
    visibility = ["//visibility:public"],
)

npm_package(
    name = "pkg",
    srcs = [
        "package.json",
        ":tinyland_fingerprint",
    ],
    package = "@tummycrypt/tinyland-fingerprint",
    version = "0.3.1",
    visibility = ["//visibility:public"],
)

vitest_bin.vitest_test(
    name = "test",
    data = [
        ":node_modules",
        "tsconfig.json",
        ":node_modules/vitest",
        "vitest.config.ts",
    ] + glob(["src/**/*.ts"]) + glob(["tests/**/*.test.ts", "tests/**/*.ts"]),
    args = [
        "run",
        "--reporter=verbose",
        "--config",
        "$(rootpath vitest.config.ts)",
    ],
    log_level = "info",
    visibility = ["//visibility:public"],
)

exports_files(
    [
        "package.json",
        "tsconfig.json",
        "vitest.config.ts",
    ],
    visibility = ["//visibility:public"],
)
