module(
    name = "tummycrypt_tinyland_fingerprint",
    version = "0.3.0",
    compatibility_level = 1,
)

bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "aspect_rules_js", version = "2.9.1")
bazel_dep(name = "aspect_rules_ts", version = "3.8.4")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_nodejs", version = "6.7.3")

# Inter-module dependencies
# CARE ITEM (TIN-1744, 5/5): tummycrypt_tinyland_security dropped here.
# 0.2.3 wired this bazel_dep only to satisfy FingerprintClientIdentityService's
# `isTempFingerprint` import from @tummycrypt/tinyland-security — a package
# that was never declared in package.json's own dependencies (a latent gap;
# it worked only because Bazel linked it directly, bypassing pnpm
# resolution). That import is now inlined locally (see
# FingerprintClientIdentityService.ts), so nothing in src/ references
# tinyland-security anymore. Vendored 0.3.0 (monorepo) still carries the
# equivalent dead wiring in its own BUILD.bazel; recommend it drop its copy
# too. Flagged in the PR body as a hygiene decision, not silently dropped.
#
# No inter-module bazel_dep remains. tinyland-otel was only an unused
# devDependency and optional peer (nothing in src/ or tests/ imports it); it
# made npm_translate_lock fetch @tummycrypt/tinyland-otel 0.2.2 from npmjs into
# every consumer graph, against RU6 (Bazel-only in-house distribution).

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "22.13.1")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(
    name = "pnpm",
    pnpm_version = "10.13.1",
)
use_repo(pnpm, "pnpm")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "tummycrypt_tinyland_fingerprint_npm",
    data = [
        "//:package.json",
        "//:pnpm-workspace.yaml",
    ],
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "tummycrypt_tinyland_fingerprint_npm")

rules_ts_ext = use_extension("@aspect_rules_ts//ts:extensions.bzl", "ext")
rules_ts_ext.deps(ts_version = "5.9.3")
use_repo(rules_ts_ext, "npm_typescript")
